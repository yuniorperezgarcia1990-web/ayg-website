  <p class="subtitle">
    Solutions tailored to your business, job site or project.
  </p>

  <div class="service-list">

    <div class="service">
      <h3>Container Sales</h3>
      <p>Container options for a wide range of needs.</p>
    </div>

    <div class="service">
      <h3>Rentals</h3>
      <p>Flexible container rental solutions.</p>
    </div>

