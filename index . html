<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AYG Transport Service Inc. | Shipping Containers</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f5f5;
  color:#171717;
}

header{
  background:#111;
  color:white;
  padding:18px 7%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
}

.logo{
  font-size:24px;
  font-weight:900;
}

.logo span{
  color:#e3262e;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:22px;
  font-weight:bold;
}

.hero{
  min-height:580px;
  background:
  linear-gradient(rgba(0,0,0,.70),rgba(0,0,0,.70)),
  url('https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1600&q=80');
  background-size:cover;
  background-position:center;
  color:white;
  display:flex;
  align-items:center;
  padding:70px 8%;
}

.hero-content{
  max-width:750px;
}

.hero h1{
  font-size:55px;
  line-height:1.05;
  margin-bottom:20px;
}

.hero h1 span{
  color:#e3262e;
}

.hero p{
  font-size:21px;
  line-height:1.6;
  margin-bottom:30px;
}

.btn{
  display:inline-block;
  padding:15px 25px;
  margin:5px;
  border-radius:5px;
  text-decoration:none;
  font-weight:bold;
}

.red{
  background:#e3262e;
  color:white;
}

.white{
  background:white;
  color:#111;
}

.section{
  padding:70px 8%;
  text-align:center;
}

.section h2{
  font-size:38px;
  margin-bottom:12px;
}

.subtitle{
  color:#666;
  margin-bottom:40px;
  font-size:18px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:25px;
}

.card{
  background:white;
  padding:35px 25px;
  border-radius:10px;
  box-shadow:0 6px 22px rgba(0,0,0,.10);
}

.card h3{
  font-size:28px;
  margin-bottom:15px;
}

.card .size{
  font-size:45px;
  font-weight:900;
  color:#e3262e;
}

.services{
  background:#171717;
  color:white;
}

.services .subtitle{
  color:#ccc;
}

.service-list{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.service{
  border:1px solid #444;
  padding:30px 15px;
  border-radius:8px;
}

.service h3{
  color:#e3262e;
  margin-bottom:10px;
}

.cta{
  background:#e3262e;
  color:white;
  padding:65px 8%;
  text-align:center;
}

.cta h2{
  font-size:40px;
  margin-bottom:15px;
}

.cta p{
  font-size:19px;
  margin-bottom:25px;
}

footer{
  background:#080808;
  color:#aaa;
  text-align:center;
  padding:30px;
}

@media(max-width:800px){
  .hero h1{
    font-size:40px;
  }

  nav{
    margin-top:15px;
  }

  nav a{
    margin:8px;
  }

  .cards,
  .service-list{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
